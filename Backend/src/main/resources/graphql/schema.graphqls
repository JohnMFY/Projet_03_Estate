type Query {
    me: UserPayload!
}

type Mutation {
    login(input: LoginInput!): AuthPayload!
}

input LoginInput {
    email: String!
    password: String!
}

type AuthPayload {
    token: String!
}

type UserPayload {
    id: Int!
    name: String!
    email: String!
    created_at: String
    updated_at: String
}